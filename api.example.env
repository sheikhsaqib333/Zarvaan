# Backend settings for the Express service. Configure these in Render, not in Vercel.
NODE_ENV=production
STORE_DATA_DIR=/var/data
ADMIN_PASSCODE=replace-with-a-private-passcode-at-least-8-characters
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
EDGE_SHARED_SECRET=replace-with-a-separate-long-random-secret
CORS_ORIGINS=https://your-store.vercel.app
PUBLIC_BACKEND_URL=https://your-api.onrender.com
